{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nft-radar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "0 18 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nft-radar-db",
      "database_id": "a26c8371-c1ec-4257-b68e-98221c7ca192"
    }
  ]
}
